# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=        # Developer Portal > your app > Bot > Reset Token
CLIENT_ID=            # Developer Portal > your app > General Information > Application ID
GUILD_ID=             # Right-click your server icon > Copy Server ID (enable Developer Mode first)
REVIEW_CHANNEL_ID=    # Right-click #clip-review > Copy Channel ID
FINDS_CHANNEL_ID=     # Right-click #community-finds > Copy Channel ID
SITE_URL=https://fullclearmap.com
DATA_DIR=./data
